#!/bin/bash

### Required settings for lvn_paper_benchmark.bash ############################

export RUNTIME=hip
export COMPILER=/mnt/disk0/linehill/despmd-paper/builds/chipstar-23/bin/hipcc

# Function is required put can be left empty.
#
# Put commands here to output additional details about the
# environment setup. They will be recorded in the benchmark log.
function print_env_details() {
    echo "Run HIP benchmarks on debug build of Rusticl/LLVMpipe on single CPU core"
    clinfo -l
    echo
    clinfo -d 0:0 --raw | grep -E '(CL_PLATFORM_NAME|CL_DRIVER_VERSION|CL_DEVICE_VERSION|CL_DEVICE_NAME)'
}

### Additional environment setups #############################################
# Add here commands for setupping the desired benchmark environment.

export CHIP_BE=opencl
export CHIP_DEVICE_TYPE=cpu
export CHIP_LOGLEVEL=off

MESA_BUILD_DIR=${HOME}/dev/ws-mesa/builds/mesa-dbg

export OCL_ICD_VENDORS="${MESA_BUILD_DIR}/src/gallium/targets/rusticl/"
export LD_LIBRARY_PATH="${MESA_BUILD_DIR}/src/gallium/targets/rusticl/:${LD_LIBRARY_PATH:-}"
export RUSTICL_ENABLE=llvmpipe
export LP_NUM_THREADS=1

BASENAME=$(basename ${BASH_SOURCE[0]})
export PS1="(${BASENAME}) ${PS1-}"
