#!/bin/bash

### Required settings for lvn_paper_benchmark.bash ############################

export RUNTIME=sycl
export COMPILER=/mnt/disk0/linehill/tools/acpp/bin/acpp
export SYCL_TYPE=cpu
export SYCL_VENDOR=AdaptiveCpp

# Function is required put can be left empty.
#
# Put commands here to output additional details about the
# environment setup. They will be recorded in the benchmark log.
function print_env_details() {
    echo "Run SYCL benchmarks on AdaptiveCpp/PoCL-LVN on single CPU core"

    echo
    echo "clinfo details:"
    clinfo -l
    echo
    clinfo -d 0:0 --raw | grep -E '(CL_PLATFORM_NAME|CL_DRIVER_VERSION|CL_DEVICE_VERSION|CL_DEVICE_NAME)'

    echo "AdaptiveCPP devices:"
    /mnt/disk0/linehill/tools/acpp/bin/acpp-info -l
}

### Additional environment setups #############################################
# Add here commands for setupping the desired benchmark environment.

source /mnt/disk0/linehill/despmd-paper/pocl-lvn :
export POCL_DEVICES=cpu
export POCL_MAX_COMPUTE_UNITS=1
export POCL_UNIFORMIZE_DIVERGENT_EXITS=1

export ACPP_VISIBILITY_MASK=ocl:0

BASENAME=$(basename ${BASH_SOURCE[0]})
export POCL_CACHE_DIR="$PWD/pocl-kcache/${BASENAME}"
rm -rf "${POCL_CACHE_DIR}"

export PS1="(${BASENAME}) ${PS1-}"
