#!/bin/bash

### Required settings for lvn_paper_benchmark.bash ############################

ACPP_DIR=/mnt/disk0/linehill/tools/acpp

export RUNTIME=sycl
export COMPILER=${ACPP_DIR}/bin/acpp
export SYCL_TYPE=cpu
export SYCL_VENDOR=AdaptiveCpp

# Function is required put can be left empty.
#
# Put commands here to output additional details about the
# environment setup. They will be recorded in the benchmark log.
function print_env_details() {
    echo "Run SYCL benchmarks on AdaptiveCPP/OpenMP on single CPU core"

    echo "AdaptiveCPP devices:"
    ${ACPP_DIR}/bin/acpp-info -l
}

### Additional environment setups #############################################
# Add here commands for setupping the desired benchmark environment.

export ACPP_VISIBILITY_MASK=omp

# Might not strictly limit threads in parallel regions to one:
#
#   "However, when OMP_THREAD_LIMIT is much smaller than the number of
#   threads that are required in the program, the parallel region
#   might still run in parallel but with less number of threads."
export OMP_THREAD_LIMIT=1

BASENAME=$(basename ${BASH_SOURCE[0]})
export PS1="(${BASENAME}) ${PS1-}"
